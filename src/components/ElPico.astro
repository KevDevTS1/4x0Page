---
import tasas from '../data/tasas.json';
import { senales } from '../data/contenido.js';

const fmt = (n) => n.toFixed(1).replace('.', ',');
const anios = Object.keys(tasas);
const serie = anios.map((a) => ({
  anio: a,
  jovenes: tasas[a].Edad['17 a 21 años'],
  general: tasas[a].General['No Aplica'],
}));

// Gráfica de tendencia
const W = 640, H = 380, m = { izq: 44, der: 24, arr: 24, aba: 40 };
const x = (i) => m.izq + (i * (W - m.izq - m.der)) / (anios.length - 1);
const y = (v) => H - m.aba - (v / 400) * (H - m.arr - m.aba);
const trazo = (campo) => serie.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p[campo]).toFixed(1)}`).join(' ');

// Edades 2021, ordenadas por edad inicial (el JSON las trae en orden alfabético)
const edades = Object.entries(tasas['2021'].Edad)
  .map(([grupo, tasa]) => ({ grupo: grupo.replace(' años', ''), tasa }))
  .sort((a, b) => parseInt(a.grupo) - parseInt(b.grupo));
const maxEdad = Math.max(...edades.map((e) => e.tasa));

const u = tasas['2021'];
const pico = u.Edad['17 a 21 años'];
const general = u.General['No Aplica'];
const veces = pico / general;
const unoDeCada = Math.round(100000 / pico / 10) * 10;
// "Por cada 10 casos en A hay N en B": N puntos frente a 10.
const brechas = [
  { a: 'Hombres', enA: 'hombres', va: u.Sexo.Hombres, b: 'Mujeres', enB: 'mujeres', vb: u.Sexo.Mujeres },
  { a: 'Ciudad', enA: 'la ciudad', va: u['Área']['Cabecera Municipal'], b: 'Campo', enB: 'el campo', vb: u['Área']['Centros Poblados y Rural Disperso'] },
].map((g) => ({ ...g, puntos: Math.round((g.vb / g.va) * 10) }));
---
<section id="el-pico" class="pico lamina fondo-tinta">
  <div class="dentro">
    <h2>El pico</h2>
    <p class="entrada">
      En 2021, la tasa de intentos de suicidio entre jóvenes de 17 a 21 años fue
      casi {Math.round(veces)} veces la del país.
    </p>

    <div class="bloque dos">
      <div>
        <h3>De {fmt(serie[0].jovenes)} a {fmt(pico)} en cinco años</h3>
        <p>
          Cada punto es la tasa por 100.000 habitantes. Elige un año para comparar a los
          jóvenes de 17 a 21 con el promedio general.
        </p>
        <div class="anios" role="group" aria-label="Año">
          {serie.map((p) => (
            <button type="button" data-anio={p.anio} data-j={p.jovenes} data-g={p.general} aria-pressed={p.anio === '2021'}>{p.anio}</button>
          ))}
        </div>
        <p class="lectura" data-lectura aria-live="polite"></p>
      </div>
      <figure class="tendencia">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Tasa de intentos de suicidio 2016 a 2021. Jóvenes de 17 a 21 años: de ${fmt(serie[0].jovenes)} a ${fmt(pico)}. General: de ${fmt(serie[0].general)} a ${fmt(general)}.`}>
          {[0, 100, 200, 300, 400].map((v) => (
            <g>
              <line x1={m.izq} x2={W - m.der} y1={y(v)} y2={y(v)} class="guia" />
              <text x={m.izq - 8} y={y(v) + 5} text-anchor="end" class="eje">{v}</text>
            </g>
          ))}
          {serie.map((p, i) => <text x={x(i)} y={H - 12} text-anchor="middle" class="eje">{p.anio}</text>)}
          <path d={trazo('general')} class="linea general" pathLength="1" data-linea />
          <path d={trazo('jovenes')} class="linea jovenes" pathLength="1" data-linea />
          {serie.map((p, i) => (
            <g data-punto={p.anio}>
              <circle cx={x(i)} cy={y(p.general)} r="6" class="pt general" />
              <circle cx={x(i)} cy={y(p.jovenes)} r="8" class="pt jovenes" />
            </g>
          ))}
        </svg>
        <figcaption>
          <span class="clave jovenes">17 a 21 años</span>
          <span class="clave general">Promedio general</span>
        </figcaption>
      </figure>
    </div>

    <div class="bloque dos">
      <div>
        <h3>Ninguna otra edad llega tan alto</h3>
        <p>
          Tasa de 2021 por grupo de edad. {fmt(pico)} por 100.000 equivale a cerca de
          1 de cada {unoDeCada} jóvenes de 17 a 21 años.
        </p>
      </div>
      <ol class="edades" data-edades>
        {edades.map((e) => (
          <li class:list={{ foco: e.grupo === '17 a 21' }}>
            <span class="grupo">{e.grupo}</span>
            <span class="pista"><span class="barra" style={`--w:${((e.tasa / maxEdad) * 100).toFixed(1)}%`}></span></span>
            <span class="valor">{fmt(e.tasa)}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="bloque">
      <h3>Dónde actuar primero</h3>
      <p>Con la misma cantidad de habitantes, así se reparten los casos de 2021.</p>
      <div class="brechas">
        {brechas.map((g) => (
          <div class="brecha" data-brecha>
            <p class="frase">Por cada 10 casos en {g.enA}, hay {g.puntos} en {g.enB}.</p>
            <div class="fila">
              <span class="rotulo">{g.a} <b>{fmt(g.va)}</b></span>
              <span class="puntos" aria-hidden="true">{Array.from({ length: 10 }).map(() => <i></i>)}</span>
            </div>
            <div class="fila alta">
              <span class="rotulo">{g.b} <b>{fmt(g.vb)}</b></span>
              <span class="puntos" aria-hidden="true">{Array.from({ length: g.puntos }).map(() => <i></i>)}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="bloque">
      <h3>Cinco señales para no dejar pasar</h3>
      <p>El suicidio es prevenible. Si notas una de estas señales en ti o en alguien cercano, pregunta. Si notas las dos últimas, llama hoy.</p>
      <ul class="senales">
        {senales.map((s) => <li class:list={{ urgente: s.urgente }}><span class="luz" aria-hidden="true"></span>{s.corta}</li>)}
      </ul>
      <a class="boton rosa" href="tel:106">Llamar a la Línea 106</a>
    </div>

    <p class="fuente">Fuente: INS / DANE. Tasas de intento de suicidio por cada 100.000 habitantes, Colombia, 2016-2021.</p>
  </div>
</section>

<script>
  import { animate, inView, scroll, stagger } from 'motion';

  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (n) => Number(n).toFixed(1).replace('.', ',');

  const lectura = document.querySelector('[data-lectura]');
  const botones = [...document.querySelectorAll('[data-anio]')];
  function elegir(boton) {
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
    const { anio, j, g } = boton.dataset;
    document.querySelectorAll('[data-punto]').forEach((p) => p.classList.toggle('activo', p.dataset.punto === anio));
    lectura.textContent = `${anio}: ${fmt(j)} entre jóvenes de 17 a 21 frente a ${fmt(g)} en general. Son ${fmt(j / g)} veces más.`;
  }
  botones.forEach((b) => b.addEventListener('click', () => elegir(b)));
  elegir(botones[botones.length - 1]);

  if (!quieto) {
    const figura = document.querySelector('.tendencia');
    document.querySelectorAll('[data-linea]').forEach((linea) => {
      scroll(animate(linea, { strokeDashoffset: [1, 0] }, { ease: 'linear' }),
        { target: figura, offset: ['start 0.9', 'center 0.45'] });
    });

    inView('[data-edades]', (lista) => {
      animate(lista.querySelectorAll('.barra'), { scaleX: [0, 1] },
        { delay: stagger(0.05), duration: 0.7, ease: [0.2, 0.8, 0.2, 1] });
    }, { amount: 0.3 });

    document.querySelectorAll('[data-brecha]').forEach((brecha) => {
      inView(brecha, () => {
        animate(brecha.querySelectorAll('i'), { scale: [0, 1] },
          { delay: stagger(0.04), type: 'spring', stiffness: 300, damping: 15 });
      }, { amount: 0.6 });
    });
  }
</script>

<style>
  .bloque { margin-top: clamp(4rem, 9vw, 7rem); }
  .bloque h3 { color: var(--sol); margin-bottom: 0.8rem; }
  .dos { display: grid; gap: 2rem; }
  @media (min-width: 56rem) { .dos { grid-template-columns: 5fr 7fr; gap: 4rem; align-items: start; } }

  .anios { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .anios button {
    background: transparent; border: 2px solid var(--lila); border-radius: 999px;
    padding: 0.35rem 0.9rem; font-weight: 700;
  }
  .anios button[aria-pressed='true'] { background: var(--sol); border-color: var(--sol); color: var(--tinta); }
  .lectura { margin-top: 1rem; font-size: var(--paso-1); line-height: 1.25; font-family: var(--display); font-weight: 700; min-height: 4em; }

  .tendencia { margin: 0; }
  .guia { stroke: #ffffff26; stroke-width: 1; }
  .eje { fill: var(--lila); font-size: 15px; font-family: var(--texto); }
  .linea { fill: none; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; }
  .linea.jovenes { stroke: var(--sol); stroke-width: 7; }
  .linea.general { stroke: var(--menta); }
  .pt.jovenes { fill: var(--sol); }
  .pt.general { fill: var(--menta); }
  .pt { stroke: var(--tinta); stroke-width: 3; transition: r 0.2s; }
  .activo .pt { stroke: var(--blanco); stroke-width: 4; r: 11px; }
  figcaption { display: flex; gap: 1.5rem; margin-top: 0.8rem; font-size: var(--paso--1); }
  .clave::before { content: ''; display: inline-block; width: 1.4rem; height: 0.4rem; border-radius: 99px; margin-right: 0.5rem; vertical-align: middle; }
  .clave.jovenes::before { background: var(--sol); }
  .clave.general::before { background: var(--menta); }

  .edades { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .edades li { display: grid; grid-template-columns: 4.6rem 1fr 3.6rem; gap: 0.7rem; align-items: center; font-size: var(--paso--1); }
  .edades .pista { height: 1.25rem; }
  .edades .barra { display: block; height: 100%; width: var(--w); background: var(--lila); border-radius: 0 99px 99px 0; transform-origin: left; }
  .edades .valor { text-align: right; font-variant-numeric: tabular-nums; }
  .edades .foco { font-weight: 800; color: var(--sol); font-size: var(--paso-0); }
  .edades .foco .barra { background: var(--sol); }
  .edades .foco .pista { height: 2rem; }

  .brechas { display: grid; gap: 3rem; margin-top: 2rem; }
  @media (min-width: 56rem) { .brechas { grid-template-columns: 1fr 1fr; } }
  .frase { font-family: var(--display); font-weight: 700; font-size: var(--paso-1); line-height: 1.2; margin-bottom: 1.2rem; max-width: 22ch; }
  .fila { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.8rem; align-items: center; margin-bottom: 0.8rem; }
  .rotulo { font-size: var(--paso--1); }
  .rotulo b { display: block; font-size: var(--paso-0); }
  .puntos { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .puntos i { width: 1.15rem; height: 1.15rem; border-radius: 50%; background: var(--menta); }
  .alta .puntos i { background: var(--rosa); }

  .senales { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 0.9rem; font-family: var(--display); font-weight: 700; font-size: var(--paso-1); line-height: 1.15; }
  .senales li { display: flex; align-items: center; gap: 0.9rem; }
  .luz { flex: none; width: 1.3rem; height: 1.3rem; border-radius: 50%; background: var(--sol); }
  .urgente .luz { background: var(--rosa); box-shadow: 0 0 0 5px #ff2d7840; }

  .fuente { margin-top: 4rem; font-size: var(--paso--1); color: var(--lila); }
</style>
