---
// Marca 4×0: el cero es un globo de diálogo. El volumen son copias de cada
// glifo desplazadas según --dx/--dy, que la portada mueve con el cursor.
// `uid` evita ids repetidos cuando hay más de un logo en la página.
const { uid = 'logo', capas = 8, paso = 1.3, sombra = 'var(--tinta)', puntos = false, class: clase } = Astro.props;
const fondo = Array.from({ length: capas }, (_, i) => capas - i);
const glifos = [
  { id: '4', color: 'var(--sol)' },
  { id: 'x', color: 'var(--rosa)' },
  { id: '0', color: 'var(--sol)' },
];
---
<svg class:list={['logo', clase]} viewBox="-8 0 296 168" stroke-width="5" stroke-linejoin="round" aria-hidden="true" data-logo>
  <defs>
    <path id={`${uid}-4`} fill-rule="evenodd" d="M62,10 H88 V88 H100 V112 H88 V140 H60 V112 H4 V90 Z M60,48 V88 H31 Z" />
    <g id={`${uid}-x`}>
      <rect x="108" y="73.5" width="46" height="13" rx="6.5" transform="rotate(45 131 80)" />
      <rect x="108" y="73.5" width="46" height="13" rx="6.5" transform="rotate(-45 131 80)" />
    </g>
    <g id={`${uid}-0`}>
      <path d="M180,104 L168,150 L218,122 Z" />
      <path fill-rule="evenodd" d="M213,10 h4 a50,50 0 0 1 50,50 v18 a50,50 0 0 1 -50,50 h-4 a50,50 0 0 1 -50,-50 v-18 a50,50 0 0 1 50,-50 Z M213,40 h4 a22,22 0 0 1 22,22 v14 a22,22 0 0 1 -22,22 h-4 a22,22 0 0 1 -22,-22 v-14 a22,22 0 0 1 22,-22 Z" />
    </g>
  </defs>
  {glifos.map((g) => (
    <g class={`glifo g${g.id}`} data-glifo data-por={g.id === 'x' ? '' : undefined}>
      {fondo.map((i) => (
        <use href={`#${uid}-${g.id}`} fill={sombra} stroke={sombra}
          style={`transform: translate(calc(var(--dx, 1) * ${(i * paso).toFixed(1)}px), calc(var(--dy, 1) * ${(i * paso).toFixed(1)}px))`} />
      ))}
      <use href={`#${uid}-${g.id}`} fill={g.color} stroke={sombra} />
      {puntos && g.id === '0' && (
        <g class="puntos" fill="var(--blanco)" stroke="none">
          <circle cx="203" cy="69" r="4.5" /><circle cx="215" cy="69" r="4.5" /><circle cx="227" cy="69" r="4.5" />
        </g>
      )}
    </g>
  ))}
</svg>

<style>
  .logo { overflow: visible; display: block; }
  .glifo { transform-box: fill-box; transform-origin: center; }
  .puntos circle { animation: escribe 1.4s ease-in-out infinite; }
  .puntos circle:nth-child(2) { animation-delay: 0.18s; }
  .puntos circle:nth-child(3) { animation-delay: 0.36s; }
  @keyframes escribe { 0%, 60%, 100% { transform: translateY(0); opacity: 0.55; } 30% { transform: translateY(-7px); opacity: 1; } }
</style>
