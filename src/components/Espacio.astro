---
import { amigo } from '../data/chat.js';
import { destinos } from '../data/peso.js';
---
<section id="espacio" class="lamina fondo-tinta espacio">
  <div class="dentro">
    <h2>Vívelo</h2>
    <p class="entrada">Dos experiencias cortas para practicar lo que cuenta este especial. Elige una.</p>

    <div class="eleccion" data-eleccion>
      <button type="button" class="carta sol" data-abrir="chat">
        <span class="dur">3 minutos</span>
        <strong>Te escribió un amigo</strong>
        <span>Son las 11 de la noche y {amigo} no está bien. Lo que respondas cambia la conversación.</span>
      </button>
      <button type="button" class="carta menta" data-abrir="peso">
        <span class="dur">2 minutos</span>
        <strong>Suelta el peso</strong>
        <span>Arrastra lo que cargas y entrégaselo a alguien. Mientras más entregas, más te enderezas.</span>
      </button>
    </div>

    <div class="escena" data-escena="chat" hidden>
      <div class="telefono">
        <header>
          <span class="avatar" aria-hidden="true">{amigo[0]}</span>
          <div><b>{amigo}</b><small data-estado>en línea</small></div>
        </header>
        <div class="medidor">
          <span>Qué tanto se abre {amigo}</span>
          <div><i data-medidor></i></div>
        </div>
        <div class="mensajes" data-mensajes role="log" aria-live="polite"></div>
        <div class="respuestas" data-respuestas></div>
      </div>
      <div class="resumen" data-resumen hidden tabindex="-1"></div>
      <p class="aclara">{amigo} es un personaje. Si algo así te pasa a ti o a alguien cercano, llama a la <a href="tel:106">Línea 106</a>.</p>
      <button type="button" class="volver" data-volver>Elegir otra experiencia</button>
    </div>

    <div class="escena" data-escena="peso" hidden>
      <p class="peso-guia" data-peso-guia aria-live="polite"></p>
      <div class="arena" data-arena>
        <div class="destinos">
          {destinos.map((d) => (
            <div class="destino" data-destino={d.id} style={`--c:${d.color}`}>
              <span class="cara" aria-hidden="true">{d.id === 'linea' ? '106' : d.nombre.split(' ').pop()[0].toUpperCase()}</span>
              <b>{d.nombre}</b>
              <small data-cuenta></small>
              <em data-dice hidden>{d.dice}</em>
            </div>
          ))}
        </div>
        <svg class="figura" data-figura aria-hidden="true"></svg>
      </div>
      <p class="oculto-visual">Con teclado: enfoca una piedra y presiona Enter para entregarla.</p>
      <div class="peso-fin" data-peso-fin hidden tabindex="-1">
        <h3>Ya no lo cargas a solas</h3>
        <p>Nada de esto desapareció, pero ahora lo sostienen más manos. En la vida real empieza igual: contándole a alguien.</p>
        <ul data-peso-quien></ul>
        <p class="acciones">
          <button type="button" class="boton" data-peso-otra>Volver a cargar</button>
          <a class="boton rosa" href="tel:106">Llamar a la Línea 106</a>
        </p>
      </div>
      <button type="button" class="volver" data-volver>Elegir otra experiencia</button>
    </div>
  </div>
</section>

<script>
  import '../scripts/espacio.js';
</script>

<style is:global>
  .espacio [hidden] { display: none !important; }
  .espacio .eleccion { display: grid; gap: 1.5rem; margin-top: 3rem; }
  @media (min-width: 48rem) { .espacio .eleccion { grid-template-columns: 1fr 1fr; } }
  .espacio .carta {
    display: grid; gap: 0.8rem; align-content: start; text-align: left; min-height: 15rem;
    padding: clamp(1.4rem, 3vw, 2.2rem); border: 4px solid var(--tinta); border-radius: 1.6rem;
    color: var(--tinta); font-size: var(--paso-0); line-height: 1.4;
    box-shadow: 10px 10px 0 var(--azul); transition: transform 0.15s, box-shadow 0.15s;
  }
  .espacio .carta.sol { background: var(--sol); }
  .espacio .carta.menta { background: var(--menta); }
  .espacio .carta:hover { transform: translate(-4px, -4px) rotate(-1deg); box-shadow: 16px 16px 0 var(--rosa); }
  .espacio .carta strong { font-family: var(--display); font-weight: 800; font-size: var(--paso-2); line-height: 1; }
  .espacio .dur { font-weight: 700; font-size: var(--paso--1); }

  .espacio .escena { margin-top: 3rem; display: grid; justify-items: center; gap: 1.5rem; }
  .espacio .volver { background: transparent; border: 2px solid var(--lila); border-radius: 999px; padding: 0.45rem 1.1rem; font-weight: 700; font-size: var(--paso--1); }
  .espacio .volver:hover { background: var(--lila); color: var(--tinta); }
  .espacio .aclara { font-size: var(--paso--1); color: var(--lila); text-align: center; }

  /* Chat */
  .espacio .telefono {
    width: 100%; max-width: 26rem; background: #ece8ff; color: var(--tinta);
    border: 4px solid var(--blanco); border-radius: 2rem; overflow: hidden;
    box-shadow: 12px 12px 0 var(--azul); display: grid; grid-template-rows: auto auto 1fr auto;
  }
  .espacio .telefono header { display: flex; align-items: center; gap: 0.8rem; padding: 0.9rem 1.1rem; background: var(--azul); color: var(--blanco); }
  .espacio .telefono header b { display: block; line-height: 1.1; }
  .espacio .telefono header small { font-size: 0.8rem; color: var(--lila); }
  .espacio .avatar { width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--sol); color: var(--tinta); display: grid; place-items: center; font-family: var(--display); font-weight: 800; }
  .espacio .medidor { padding: 0.6rem 1.1rem; background: var(--blanco); font-size: 0.8rem; font-weight: 700; display: grid; gap: 0.3rem; }
  .espacio .medidor div { height: 0.55rem; background: #120a3a1f; border-radius: 99px; overflow: hidden; }
  .espacio .medidor i { display: block; height: 100%; width: 30%; background: var(--rosa); border-radius: 99px; transition: width 0.5s ease, background 0.5s; }
  .espacio .mensajes { height: min(52vh, 24rem); overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.45rem; scroll-behavior: smooth; }
  .espacio .globo { max-width: 82%; padding: 0.55rem 0.9rem; border-radius: 1.1rem; font-size: 1rem; line-height: 1.35; }
  .espacio .globo.el { align-self: flex-start; background: var(--blanco); border-bottom-left-radius: 0.3rem; }
  .espacio .globo.yo { align-self: flex-end; background: var(--azul); color: var(--blanco); border-bottom-right-radius: 0.3rem; }
  .espacio .globo.nota { align-self: center; max-width: 100%; background: none; font-size: 0.82rem; color: #120a3aaa; text-align: center; }
  .espacio .escribe { display: flex; gap: 4px; padding: 0.8rem 0.9rem; }
  .espacio .escribe i { width: 7px; height: 7px; border-radius: 50%; background: #120a3a88; animation: tecleo 1s ease-in-out infinite; }
  .espacio .escribe i:nth-child(2) { animation-delay: 0.15s; }
  .espacio .escribe i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes tecleo { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-5px); } }
  .espacio .respuestas { display: grid; gap: 0.5rem; padding: 0.8rem; background: var(--blanco); min-height: 4rem; }
  .espacio .respuestas button {
    text-align: left; background: var(--blanco); border: 2px solid var(--tinta); border-radius: 1rem;
    padding: 0.6rem 0.9rem; font-size: 0.98rem; line-height: 1.3; transition: background 0.15s, transform 0.15s;
  }
  .espacio .respuestas button:hover { background: var(--sol); transform: translateX(4px); }

  .espacio .resumen { width: 100%; max-width: 44rem; background: var(--blanco); color: var(--tinta); border-radius: 1.6rem; padding: clamp(1.3rem, 4vw, 2.5rem); box-shadow: 12px 12px 0 var(--azul); }
  .espacio .resumen h3 { color: var(--azul); font-size: var(--paso-2); margin-bottom: 0.8rem; }
  .espacio .resumen ol { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1.1rem; }
  .espacio .resumen li { border-left: 6px solid var(--menta); padding-left: 1rem; }
  .espacio .resumen li.cierra { border-color: var(--rosa); }
  .espacio .resumen li.igual { border-color: var(--sol); }
  .espacio .resumen q { display: block; font-family: var(--display); font-weight: 700; line-height: 1.25; }
  .espacio .resumen small { display: block; font-size: var(--paso--1); margin-top: 0.2rem; }
  .espacio .resumen .mejor { margin-top: 0.4rem; font-weight: 700; }
  .espacio .resumen .acciones { display: flex; flex-wrap: wrap; gap: 0.8rem; max-width: none; }

  /* Suelta el peso */
  .espacio .peso-guia { font-family: var(--display); font-weight: 800; font-size: var(--paso-1); line-height: 1.15; text-align: center; min-height: 2.4em; max-width: 30ch; }
  .espacio .arena {
    position: relative; width: 100%; max-width: 54rem; height: 40rem; overflow: hidden;
    border-radius: 1.6rem; border: 4px solid var(--azul); touch-action: pan-y; user-select: none; -webkit-user-select: none;
    background: linear-gradient(#2a1ae6 0 calc(100% - 16px), #ffd60a calc(100% - 16px));
  }
  .espacio .figura { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .espacio .piedra {
    position: absolute; left: 0; top: 0; padding: 0 0.3em; border-radius: 50%;
    border: 4px solid var(--tinta); color: var(--tinta); font-family: var(--display); font-weight: 800; line-height: 1.05;
    display: grid; place-items: center; text-align: center; box-shadow: inset -6px -8px 0 #120a3a26;
    cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none; will-change: transform;
  }
  .espacio .piedra.agarrada { cursor: grabbing; z-index: 3; box-shadow: inset -6px -8px 0 #120a3a26, 0 0 0 6px #ffffff66; }

  .espacio .destinos { position: absolute; z-index: 1; top: 0.8rem; left: 0.5rem; right: 0.5rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.3rem; pointer-events: none; }
  .espacio .destino { position: relative; display: grid; justify-items: center; gap: 0.15rem; text-align: center; font-size: 0.82rem; line-height: 1.15; }
  .espacio .destino .cara {
    width: 3.9rem; height: 3.9rem; border-radius: 50%; background: var(--c); color: var(--tinta);
    border: 4px solid var(--tinta); outline: 3px dashed #ffffff88; outline-offset: 5px;
    display: grid; place-items: center; font-family: var(--display); font-weight: 800; font-size: 1.2rem; margin-bottom: 0.5rem;
    transition: outline-offset 0.15s, outline-color 0.15s;
  }
  .espacio .destino.cerca .cara { outline-color: var(--blanco); outline-style: solid; outline-offset: 10px; }
  .espacio .destino small { color: var(--lila); font-weight: 700; min-height: 1.1em; }
  .espacio .destino em {
    position: absolute; top: 4.9rem; left: 50%; translate: -50% 0; z-index: 4; width: max-content; max-width: 10rem;
    background: var(--blanco); color: var(--tinta); font-style: normal; font-weight: 700; padding: 0.4rem 0.7rem; border-radius: 0.8rem; border-bottom: 4px solid var(--c);
  }
  @media (min-width: 48rem) {
    .espacio .destinos { top: 0; bottom: 16px; left: auto; right: 1.2rem; width: 9.5rem; grid-template-columns: 1fr; align-content: space-evenly; }
    .espacio .destino { font-size: 0.95rem; }
    .espacio .destino .cara { width: 4.8rem; height: 4.8rem; font-size: 1.5rem; }
    .espacio .destino em { top: 1rem; left: auto; right: calc(100% + 0.4rem); translate: 0 0; }
  }

  .espacio .peso-fin { width: 100%; max-width: 44rem; background: var(--blanco); color: var(--tinta); border-radius: 1.6rem; padding: clamp(1.3rem, 4vw, 2.5rem); box-shadow: 12px 12px 0 var(--azul); }
  .espacio .peso-fin h3 { color: var(--azul); font-size: var(--paso-2); margin-bottom: 0.8rem; }
  .espacio .peso-fin ul { list-style: none; padding: 0; margin: 1.3rem 0; display: grid; gap: 0.5rem; font-weight: 700; }
  .espacio .peso-fin li { border-left: 8px solid var(--c); padding-left: 0.8rem; }
  .espacio .peso-fin .acciones { display: flex; flex-wrap: wrap; gap: 0.8rem; max-width: none; }
</style>
